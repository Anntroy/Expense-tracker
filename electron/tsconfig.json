{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "db/**/*.ts", "../src/lib/**/*.ts"],
  "exclude": ["../src/**/*.test.ts", "*.test.ts", "db/**/*.test.ts"]
}
